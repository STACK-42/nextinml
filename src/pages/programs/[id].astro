---
import type { GetStaticPaths } from "astro";
import { ArrowLeft, CalendarDays, Clock, Globe, MapPin, ShieldCheck } from "lucide-react";

import Base from "@/layouts/Base.astro";
import Writeups from "@/components/Writeups.astro";
import { StatusBadge } from "@/components/StatusBadge";
import { assertWriteupsHavePrograms, getPrograms } from "@/lib/content";
import { programLd } from "@/lib/seo";
import { deadlineLabel, isStale, verifiedLabel, type Program } from "@/lib/programs";

export const getStaticPaths = (async () => {
  const programs = await getPrograms();
  await assertWriteupsHavePrograms(programs);
  return programs.map((program) => ({ params: { id: program.id }, props: { program } }));
}) satisfies GetStaticPaths;

const { program } = Astro.props as { program: Program };

const stats = [
  { icon: CalendarDays, label: "Deadline", value: deadlineLabel(program) },
  { icon: Globe, label: "Format", value: program.format },
  { icon: MapPin, label: "Region", value: program.region },
  { icon: MapPin, label: "Location", value: program.location },
  { icon: CalendarDays, label: "Dates", value: program.dates },
  { icon: Clock, label: "Duration", value: program.duration },
].filter((s) => s.value);

const stale = isStale(program.lastVerified);

const sections = [
  { title: "Who can apply", body: program.eligibility },
  { title: "Cost & funding", body: program.cost },
].filter((s) => s.body);
---

<Base
  title={`${program.name} · NextInML`}
  description={program.description}
  jsonLd={programLd(program, Astro.site!)}
>
  <section class="max-w-3xl mx-auto px-6 py-12 md:py-16">
    <a
      href="/programs/"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-primary-text transition-colors mb-8"
    >
      <ArrowLeft className="h-4 w-4" />
      All programs
    </a>

    <article>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <div class="flex items-center gap-4">
          <span class="type-tag">{program.type}</span>
          <StatusBadge program={program} />
        </div>
        <span
          class:list={[
            "flex items-center gap-1.5 text-[12px]",
            stale ? "text-vermilion" : "text-muted-foreground",
          ]}
        >
          <ShieldCheck className="h-3.5 w-3.5" />
          {verifiedLabel(program.lastVerified)}
          {stale && <span> · may be out of date</span>}
        </span>
      </div>

      <h1 class="text-3xl md:text-5xl font-bold tracking-[-0.03em] mb-2">{program.name}</h1>
      {program.organizer && <p class="text-muted-foreground mb-6">{program.organizer}</p>}

      <div class="grid sm:grid-cols-3 gap-px bg-border border border-border mb-10">
        {
          stats.map(({ icon: Icon, label, value }) => (
            <div class="bg-surface p-4">
              <p class="flex items-center gap-1.5 text-[11px] uppercase tracking-wider text-muted-foreground mb-1.5">
                <Icon className="h-4 w-4" />
                {label}
              </p>
              <p class="font-semibold">{value}</p>
            </div>
          ))
        }
      </div>

      <p class="text-subtle leading-relaxed mb-10 whitespace-pre-line">
        {program.longDescription || program.description}
      </p>

      {
        program.topics.length > 0 && (
          <section class="mb-8">
            <h2 class="eyebrow text-primary-text! mb-3">Topics covered</h2>
            <div class="flex flex-wrap gap-2">
              {program.topics.map((t) => (
                <span class="border border-border px-3 py-1.5 text-[13px]">{t}</span>
              ))}
            </div>
          </section>
        )
      }

      {
        sections.map((s) => (
          <section class="mb-8">
            <h2 class="eyebrow text-primary-text! mb-3">{s.title}</h2>
            <p class="text-subtle leading-relaxed whitespace-pre-line">{s.body}</p>
          </section>
        ))
      }

      <div class="mt-10">
        <a
          href={program.applicationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn bg-primary text-white hover:bg-foreground hover:text-background"
        >
          Apply / Learn more <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    <Writeups programId={program.id} />
  </section>
</Base>
