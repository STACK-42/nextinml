---
import Base from "@/layouts/Base.astro";
import { ProgramDirectory } from "@/components/ProgramDirectory";
import { getPrograms } from "@/lib/content";
import { programListLd } from "@/lib/seo";

const programs = await getPrograms();
---

<Base
  title="ML summer schools, fellowships and internships · NextInML"
  description="Browse machine learning summer and winter schools, research fellowships, and undergraduate internships, with deadlines, eligibility, cost, and when each listing was last checked."
  jsonLd={programListLd(programs, Astro.site!)}
>
  <section class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <p class="eyebrow mb-3">Directory</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.03em] mb-3">All programs</h1>
    <ProgramDirectory client:load programs={programs} />
  </section>
</Base>
