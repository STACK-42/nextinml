---
import Base from "@/layouts/Base.astro";
import { ProgramDirectory } from "@/components/ProgramDirectory";
import { getPrograms } from "@/lib/content";

const programs = await getPrograms();
---

<Base
  title="Programs · NextInML"
  description="Browse ML summer schools, fellowships, and internships open to students worldwide."
>
  <section class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <p class="eyebrow mb-3">Directory</p>
    <h1 class="text-4xl md:text-5xl font-extrabold mb-3">All programs</h1>
    <ProgramDirectory client:load programs={programs} />
  </section>
</Base>
