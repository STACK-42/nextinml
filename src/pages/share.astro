---
import Base from "@/layouts/Base.astro";
import { shareFormUrl } from "@/lib/site";

const questions = [
  "What did your application include, and how long did it take?",
  "What background did you have going in, and was it enough?",
  "What did a typical day look like?",
  "What did it cost you, including travel and visas, and what was covered?",
  "What did you get out of it a few months later?",
  "Who should apply, and who should skip it?",
];
---

<Base
  title="Share your experience · NextInML"
  description="Attended an ML summer school, fellowship, or internship? Write about what it was like for the next student deciding whether to apply."
>
  <section class="max-w-3xl mx-auto px-6 py-12 md:py-16">
    <p class="eyebrow mb-3">Writeups</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.03em] mb-5">Share your experience</h1>
    <p class="text-lg text-subtle leading-relaxed mb-10">
      If you attended a program listed here, or one that should be, an honest account of what it was
      like helps the next student decide whether to apply. Program pages tell you what organisers
      promise. Writeups tell you what happened.
    </p>

    <div class="border-t-2 border-foreground pt-6 mb-10">
      <h2 class="eyebrow text-primary-text! mb-4">What to write about</h2>
      <p class="text-subtle mb-4">
        Write in the first person, about your own time there. These questions tend to help:
      </p>
      <ol class="space-y-3">
        {
          questions.map((q, i) => (
            <li class="flex gap-4 bg-surface border border-border p-4">
              <span class="font-bold text-primary-text">{i + 1}</span>
              <span>{q}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="border-t-2 border-foreground pt-6 mb-10">
      <h2 class="eyebrow text-primary-text! mb-4">What happens next</h2>
      <p class="text-subtle leading-relaxed">
        Every submission is read before it goes up. We may edit for length and clarity, and we'll
        check anything unclear with you before publishing. Your writeup appears on the program's
        page with your name, or initials if you prefer, and the year you attended.
      </p>
    </div>

    {
      shareFormUrl ? (
        <a
          href={shareFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn bg-primary text-white hover:bg-foreground hover:text-background"
        >
          Write your experience <span aria-hidden="true">→</span>
        </a>
      ) : (
        <div class="bg-surface border border-dashed border-border p-6">
          <p class="font-semibold mb-1">Submissions open soon</p>
          <p class="text-sm text-muted-foreground">
            The submission form isn't live yet. Check back shortly.
          </p>
        </div>
      )
    }
  </section>
</Base>
