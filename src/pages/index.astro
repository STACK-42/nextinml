---
import Base from "@/layouts/Base.astro";
import Mark from "@/components/Mark.astro";
import Pattern from "@/components/Pattern.astro";
import { ProgramCard } from "@/components/ProgramCard";
import { getPrograms } from "@/lib/content";
import { inSection, isPast, type SectionId } from "@/lib/programs";

const programs = await getPrograms();
const open = programs.filter((p) => p.deadline !== null && !isPast(p.deadline));
const featured = (open.length > 0 ? open : programs).slice(0, 3);
const regionCount = new Set(programs.map((p) => p.region)).size;

const stats = [
  `${programs.length} program${programs.length === 1 ? "" : "s"}`,
  `${regionCount} region${regionCount === 1 ? "" : "s"}`,
];

const blurbs: Record<SectionId, { label: string; title: string; desc: string }> = {
  schools: {
    label: "Summer & Winter",
    title: "Summer & Winter Schools",
    desc: "Immersive, time-boxed programs with hands-on practicals and lectures from leading researchers.",
  },
  fellowships: {
    label: "Fellowships",
    title: "Research Fellowships",
    desc: "Structured programs connecting students with real research problems and dedicated mentors.",
  },
  internships: {
    label: "Internships",
    title: "Internship Programs",
    desc: "Undergraduate-accessible roles at research institutes and industry labs around the world.",
  },
};

const categories = (Object.keys(blurbs) as SectionId[]).map((id) => ({
  ...blurbs[id],
  href: `/programs?type=${id}`,
  count: programs.filter((p) => inSection(p, id)).length,
}));
---

<Base
  title="NextInML · Your next step in ML, finally visible."
  description="Discovery platform for ML summer schools, fellowships, and internships for early-stage students in MENA, Africa, and the Global South."
>
  {/* Hero: the brand panel */}
  <section
    class="relative overflow-hidden text-white flex items-center"
    style="background: var(--panel)"
  >
    <div
      data-tile-content
      class="relative z-10 w-full max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-[minmax(0,1fr)_auto] items-center gap-12"
    >
      <div>
        <p
          class="text-[12px] font-semibold uppercase tracking-[0.16em] mb-6"
          style="color: var(--panel-muted)"
        >
          Built for students outside the ambient network
        </p>
        <h1 class="text-4xl md:text-6xl font-bold leading-[1.08] tracking-[-0.03em] mb-5">
          Your next step in ML, finally visible.
        </h1>
        <p lang="ar" dir="rtl" class="text-2xl md:text-3xl font-semibold mb-6 text-left">
          خطوتك التالية في تعلّم الآلة
        </p>
        <p class="text-lg font-light max-w-xl mb-10" style="color: var(--panel-muted)">
          Summer schools, fellowships, and internships for early-stage ML students in MENA, Africa,
          and the Global South.
        </p>
        <div class="flex flex-wrap items-center gap-3 mb-10">
          <a
            href="/programs"
            class="btn bg-white text-[#121212] hover:bg-[#F2542D] hover:text-white"
          >
            Browse opportunities <span aria-hidden="true">→</span>
          </a>
          <a
            href="#experiences"
            class="btn border border-white/60 text-white hover:border-white hover:bg-white/10"
          >
            Read experiences
          </a>
        </div>
        <p class="text-sm" style="color: var(--panel-muted)">{stats.join(" · ")}</p>
      </div>
      <Mark
        size={300}
        fill="#FFFFFF"
        hole="var(--panel)"
        class="hidden md:block"
        label="NextInML mark"
      />
    </div>
    <Pattern />
  </section>

  {/* Opportunity types */}
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="grid md:grid-cols-3 gap-5">
      {
        categories.map((c) => (
          <a
            href={c.href}
            class="group bg-surface border border-border p-7 flex flex-col hover:border-primary-text transition-colors"
          >
            <p class="type-tag mb-5">{c.label}</p>
            <h3 class="text-xl font-bold mb-2">{c.title}</h3>
            <p class="text-sm text-subtle leading-relaxed mb-6">{c.desc}</p>
            <div class="mt-auto flex items-center justify-between pt-4 border-t border-border">
              <span class="text-sm text-muted-foreground">
                {c.count} program{c.count === 1 ? "" : "s"}
              </span>
              <span class="text-sm font-semibold text-primary-text group-hover:text-foreground">
                Explore →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {/* Featured programs */}
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <div class="flex items-end justify-between mb-8 border-t-2 border-foreground pt-6">
      <div>
        <p class="eyebrow mb-2">Featured</p>
        <h2 class="text-3xl font-bold">{open.length > 0 ? "Open right now" : "Programs"}</h2>
      </div>
      <a
        href="/programs"
        class="text-sm font-semibold text-primary-text hover:text-foreground hidden sm:inline"
      >
        See all →
      </a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featured.map((p) => <ProgramCard program={p} />)}
    </div>
  </section>

  {/* Call for writeups */}
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div
      class="p-10 md:p-14 flex flex-col md:flex-row md:items-center justify-between gap-8 text-white"
      style="background: var(--deep)"
    >
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-3">Found your next step? Tell us about it.</h2>
        <p class="max-w-xl" style="color: var(--deep-muted)">
          Write a review. Help the next student figure out whether to apply.
        </p>
      </div>
      <a
        href="/share"
        class="btn bg-white text-[#121212] hover:bg-[#F2542D] hover:text-white shrink-0"
      >
        Share your experience <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
