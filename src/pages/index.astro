---
import Base from "@/layouts/Base.astro";
import { ProgramCard } from "@/components/ProgramCard";
import { getPrograms } from "@/lib/content";
import { isPast } from "@/lib/programs";

const programs = await getPrograms();
const open = programs.filter((p) => p.deadline !== null && !isPast(p.deadline));
const featured = (open.length > 0 ? open : programs).slice(0, 3);
const regionCount = new Set(programs.map((p) => p.region)).size;

const stats = [
  `${programs.length} program${programs.length === 1 ? "" : "s"}`,
  `${regionCount} region${regionCount === 1 ? "" : "s"}`,
  "100% free to access",
];

const categories = [
  {
    label: "Summer & Winter",
    title: "Summer & Winter Schools",
    desc: "Immersive, time-boxed programs with hands-on practicals and lectures from leading researchers.",
    count: programs.filter((p) => p.type === "Summer School" || p.type === "Winter School").length,
  },
  {
    label: "Fellowships",
    title: "Research Fellowships",
    desc: "Structured programs connecting students with real research problems and dedicated mentors.",
    count: programs.filter((p) => p.type === "Fellowship").length,
  },
  {
    label: "Internships",
    title: "Internship Programs",
    desc: "Undergraduate-accessible roles at research institutes and industry labs around the world.",
    count: programs.filter((p) => p.type === "Internship").length,
  },
];
---

<Base
  title="NextInML · Your next step in ML, finally visible."
  description="Discovery platform for ML summer schools, fellowships, and internships for early-stage students in MENA, Africa, and the Global South."
>
  {/* Hero */}
  <section class="relative overflow-hidden">
    <svg
      aria-hidden="true"
      class="absolute -top-20 left-1/2 -translate-x-1/2 opacity-[0.05] pointer-events-none"
      width="900"
      height="900"
      viewBox="0 0 900 900"
      fill="none"
    >
      <path d="M150 650 A300 300 0 0 1 750 650" stroke="#534AB7" stroke-width="3" fill="none"
      ></path>
      <path d="M260 680 A190 190 0 0 1 640 680" stroke="#534AB7" stroke-width="3" fill="none"
      ></path>
      <circle cx="450" cy="680" r="14" fill="#534AB7"></circle>
    </svg>

    <div class="relative max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24 text-center">
      <p class="eyebrow mb-5">BUILT FOR STUDENTS OUTSIDE THE AMBIENT NETWORK</p>
      <h1 class="text-4xl md:text-6xl font-extrabold mb-6 max-w-4xl mx-auto leading-[1.12]">
        Your next step in ML
        <span class="block mt-1 text-2xl md:text-3xl font-bold text-foreground/75">
          Summer schools. Fellowships. Internships.
        </span>
        <span class="block mt-1" style="color: var(--primary)">All in one place.</span>
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-10 leading-relaxed">
        For early-stage ML students in MENA, Africa, and the Global South.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
        <a
          href="/programs"
          class="pill bg-accent text-white hover:bg-[var(--accent-dark)] transition-colors px-6 py-3 text-sm font-semibold"
        >
          Browse opportunities
        </a>
        <a
          href="#experiences"
          class="pill border-[1.5px] border-primary text-primary hover:bg-purple-50 transition-colors px-6 py-3 text-sm font-semibold"
        >
          Read experiences
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2">
        {
          stats.map((s) => (
            <span class="pill bg-purple-50 text-primary text-[12px] font-medium">{s}</span>
          ))
        }
      </div>
    </div>
  </section>

  {/* Opportunity types */}
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="grid md:grid-cols-3 gap-5">
      {
        categories.map((c) => (
          <div class="bg-surface border border-border rounded-lg p-7 hover:border-primary/60 transition-colors">
            <p class="font-mono text-[11px] uppercase tracking-wider text-primary mb-4">
              {c.label}
            </p>
            <h3 class="text-xl font-bold mb-2">{c.title}</h3>
            <p class="text-sm text-foreground/75 leading-relaxed mb-5">{c.desc}</p>
            <div class="flex items-center justify-between">
              <span class="pill bg-teal-50 text-[var(--accent-dark)] text-[12px]">
                {c.count} programs
              </span>
              <a
                href="/programs"
                class="text-sm font-medium text-accent hover:text-[var(--accent-dark)]"
              >
                Explore →
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* Featured programs */}
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="eyebrow mb-2">Featured</p>
        <h2 class="text-3xl font-extrabold">{open.length > 0 ? "Open right now" : "Programs"}</h2>
      </div>
      <a
        href="/programs"
        class="text-sm font-medium text-accent hover:text-[var(--accent-dark)] hidden sm:inline"
      >
        See all →
      </a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featured.map((p) => <ProgramCard program={p} />)}
    </div>
  </section>

  {/* CTA banner */}
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="rounded-lg p-10 md:p-14 text-center" style="background: var(--primary)">
      <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-3">
        Found your next step? Tell us about it.
      </h2>
      <p class="text-purple-50/90 mb-7 max-w-xl mx-auto">
        Write a review. Help the next student figure out whether to apply.
      </p>
      <a
        href="#submit"
        class="pill border-[1.5px] border-white text-white hover:bg-white hover:text-primary transition-colors px-6 py-3 text-sm font-semibold"
      >
        Share your experience
      </a>
    </div>
  </section>
</Base>
