---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found · NextInML">
  <section class="flex items-center justify-center px-4 py-28">
    <div class="max-w-md text-center">
      <h1 class="text-7xl font-bold text-foreground">404</h1>
      <h2 class="mt-4 text-xl font-semibold text-foreground">Page not found</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-6">
        <a
          href="/programs"
          class="pill bg-accent text-white hover:bg-[var(--accent-dark)] transition-colors px-5 py-2.5 text-sm font-semibold"
        >
          Browse all programs
        </a>
      </div>
    </div>
  </section>
</Base>
