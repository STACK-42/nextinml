---
import Base from "@/layouts/Base.astro";
import Mark from "@/components/Mark.astro";
---

<Base title="Page not found · NextInML" noindex>
  <section class="flex items-center justify-center px-4 py-28">
    <div class="max-w-md text-center">
      <Mark size={96} class="mx-auto mb-6" />
      <h1 class="text-7xl font-bold text-foreground">404</h1>
      <h2 class="mt-4 text-xl font-semibold text-foreground">Page not found</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-6">
        <a
          href="/programs"
          class="btn bg-primary text-white hover:bg-foreground hover:text-background"
        >
          Browse all programs
        </a>
      </div>
    </div>
  </section>
</Base>
