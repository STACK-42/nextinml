---
import { render } from "astro:content";

import { getWriteups } from "@/lib/content";

interface Props {
  programId: string;
}

const writeups = await getWriteups(Astro.props.programId);
const rendered = await Promise.all(
  writeups.map(async (w) => ({ ...w, Content: (await render(w)).Content })),
);
---

<section id="experiences" class="mt-14 pt-10 border-t border-border">
  <h2 class="text-sm font-bold uppercase tracking-wider text-primary mb-6">From people who went</h2>

  {
    rendered.length === 0 ? (
      <div class="bg-surface border border-dashed border-border rounded-lg p-6">
        <p class="font-semibold mb-1">No writeups yet</p>
        <p class="text-sm text-muted-foreground">
          If you attended this program, an honest account of what it was like would help the next
          person decide whether to apply.
        </p>
      </div>
    ) : (
      <div class="space-y-6">
        {rendered.map(({ data, Content }) => (
          <article class="bg-surface border border-border rounded-lg p-6 md:p-8">
            <h3 class="text-xl font-bold mb-1">{data.title}</h3>
            <p class="text-[13px] text-muted-foreground mb-5">
              {data.author}
              {data.authorContext && <span> · {data.authorContext}</span>}
              <span> · {data.cohort} cohort</span>
            </p>
            <div class="writeup text-foreground/80 leading-relaxed">
              <Content />
            </div>
          </article>
        ))}
      </div>
    )
  }
</section>
