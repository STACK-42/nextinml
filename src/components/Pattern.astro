---
// Tessellate tile repeated over the brand panel. Place it as the last child
// of a `relative overflow-hidden` element, after the content, which should be
// marked `data-tile-content` and sit above it (`relative z-10`).
//
// The inline script snaps the panel's height to whole tiles so the bottom row
// isn't cut through, and centres the tiles horizontally so both side edges are
// cut evenly. It runs right after the content is parsed, before first paint.
// Without JavaScript the panel keeps its natural height.
const TILE = 80;
const id = `tile-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class="absolute inset-0 z-0 h-full w-full pointer-events-none"
  aria-hidden="true"
  data-tessellate
>
  <defs>
    <pattern id={id} width={TILE} height={TILE} patternUnits="userSpaceOnUse">
      <path
        transform="translate(8 8)"
        d="M32 3.72L40.28 12H52V23.72L60.28 32L52 40.28V52H40.28L32 60.28L23.72 52H12V40.28L3.72 32L12 23.72V12H23.72Z"
        style="fill: var(--panel-tile)"></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>
<script is:inline define:vars={{ TILE }}>
  (function () {
    var svg = document.currentScript.previousElementSibling;
    var panel = svg.parentElement;
    var content = panel.querySelector("[data-tile-content]");
    var pattern = svg.querySelector("pattern");
    function fit() {
      if (content) {
        panel.style.height = Math.ceil(content.offsetHeight / TILE) * TILE + "px";
      }
      var offset = (((panel.clientWidth / 2 - TILE / 2) % TILE) + TILE) % TILE;
      pattern.setAttribute("x", String(offset));
    }
    fit();
    if ("ResizeObserver" in window) new ResizeObserver(fit).observe(content || panel);
  })();
</script>
